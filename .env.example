# Database Connection (PostgreSQL - Supabase / Neon / Local)
DATABASE_URL="postgresql://user:password@localhost:5432/blog_platform?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/blog_platform?schema=public"

# Authentication & Security
JWT_SECRET_KEY="super-secret-jwt-key-replace-in-production"
JWT_REFRESH_SECRET_KEY="super-secret-refresh-key-replace-in-production"
COOKIE_SECRET="cookie-secret-key-32-chars-minimum-here"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Delivery (Nodemailer - Gmail / SMTP / Resend)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="Inkwell <no-reply@inkwell.blog>"
OTP_EXPIRES_MINUTES="10"

# Optional: Cloud Image Uploads (Cloudinary / AWS S3)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
